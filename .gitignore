# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment / secrets — never commit
.env
.env.example
.env.local
.env.*.local

# Build outputs
backend/dist/
frontend/dist/

# Database files
*.db
*.db-shm
*.db-wal
backend/data/

# Hugging Face / Transformers.js model cache (downloaded on first ingest)
.cache/
backend/.cache/
.hf-cache/

# Eval suite output (timestamped runs)
eval/output/*
!eval/output/.gitkeep

# Raw corpus texts (re-fetchable via backend/scripts/fetch-corpus.ts)
corpus/*/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Docker
.docker/
