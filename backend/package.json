{
  "name": "philosophical-council-backend",
  "version": "1.0.0",
  "description": "API proxy and storage backend for The Philosophical Council",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file=../.env ./node_modules/.bin/ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "ingest": "node --env-file=../.env ./node_modules/.bin/ts-node --transpile-only scripts/ingest-corpus.ts",
    "fetch-corpus": "./node_modules/.bin/ts-node --transpile-only scripts/fetch-corpus.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "gpt-tokenizer": "^2.9.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
